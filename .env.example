# Copy to .env for local development. Never commit .env.
# On Render these are set as environment variables of the web service.
# Never write real values in the code; for GitHub Actions use repository secrets.

# Signs the session cookies. Long and random, e.g. the output of: python -c "import secrets; print(secrets.token_hex(32))"
# If it is empty, the app makes a random key at every start (all users are logged out after a restart).
SECRET_KEY=
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 1 (default) sends the session cookie only over HTTPS. Set 0 only on your own computer without HTTPS.
SESSION_COOKIE_SECURE=1

# Password of the demo accounts of scripts/run_demo.py (local demo only). If empty, a random one is
# made at every start and printed in the terminal.
CAMPUSEVENT_DEMO_PASSWORD=
