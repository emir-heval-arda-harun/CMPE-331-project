---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB
    subgraph CL["Client tier"]
        B["Web browser<br/>(desktop and mobile, 360 px and wider)"]
    end

    subgraph PL["Layer 1: Presentation (Flask)"]
        SEC["Security middleware<br/>session cookie, CSRF check,<br/>login_required, role_required"]
        BP["Blueprints<br/>auth_routes, profile_routes,<br/>event_routes, facility_routes"]
        TPL["Jinja2 templates + Bootstrap 5"]
    end

    subgraph AL["Layer 2: Application (services)"]
        AS["AuthService"]
        PS["ProfileService"]
        FS["FacilityService"]
        ES["EventService"]
    end

    subgraph DL["Layer 3: Data access and integration"]
        REPO["Repository interfaces<br/>UserRepository, ProfileRepository,<br/>FacilityRepository, EventRepository<br/>(SQLAlchemy implementations)"]
        UOW["UnitOfWork<br/>(SqlUnitOfWork)"]
        PH["PasswordHasher<br/>(Argon2PasswordHasher)"]
        MAIL["EmailSender<br/>(SmtpEmailSender)"]
    end

    subgraph EXT["Layer 4: External systems"]
        DB[("PostgreSQL 16")]
        SMTP["SMTP e-mail provider"]
    end

    DOM[["Domain model (shared by layers 1 to 3)<br/>User, Profile, Event, Facility, FacilityBlock,<br/>VerificationCode, TimeSlot, ActivityRecord,<br/>Role, EventStatus, CampusEventError subclasses"]]

    B -- "HTTPS: GET pages, POST forms with CSRF token, session cookie" --> SEC
    SEC -- "authorized request + current user" --> BP
    BP -- "render_template(page, view model)" --> TPL
    BP -- "service API calls, e.g. EventService.join_event(event_id, user_id);<br/>returns domain objects or raises CampusEventError" --> AL
    PS -- "require_role(), get_user()" --> AS
    FS -- "require_role()" --> AS
    ES -- "require_role()" --> AS
    ES -- "check_bookable(), is_available()" --> FS
    AL -- "add / get / get_for_update / search / save" --> REPO
    AL -- "begin / commit / rollback" --> UOW
    AS -- "hash / verify" --> PH
    AS -- "send_verification_code(email, code)" --> MAIL
    REPO -- "SQL through SQLAlchemy session (TLS)" --> DB
    UOW -- "BEGIN / COMMIT / ROLLBACK" --> DB
    MAIL -- "SMTP + STARTTLS" --> SMTP
    PL -. "uses" .-> DOM
    AL -. "uses" .-> DOM
    DL -. "maps rows to" .-> DOM
