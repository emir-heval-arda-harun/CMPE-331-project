        ENV["Environment variables<br/>SECRET_KEY, DATABASE_URL, SMTP_*"]
    end
    SMTP["SMTP e-mail provider"]
    U["Students and facility staff<br/>(browser)"]

    D1 -- "git push" --> GH
    GH --> T
    T -- "green" --> DPL
    DPL -- "deploy hook" --> W
    ENV -.-> W
    W -- "SQL over TLS" --> PG
    W -- "SMTP over TLS" --> SMTP
    U -- "HTTPS" --> W
