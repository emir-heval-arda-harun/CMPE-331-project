classDiagram
    class User {
        +int id
        +string email
        +string fullName
        +Role role
        +bool isVerified
    }
    class Profile {
        +int userId
        +map sports
        +map aiRatings
    }
    class Sport {
        +string name
    }
    class VerificationCode {
        +string codeHash
        +datetime expiresAt
        +bool used
    }
    class Participation {
        +datetime joinedAt
        +int teamNo
    }
    class Team {
        +int id
        +string name
    }
    class TimeSlot {
        +datetime start
        +datetime end
        +overlaps(other) bool
    }
    class Facility {
        +int id
        +string name
    }
    class FacilityBlock {
        +string reason
        +TimeSlot slot
    }
    class Match {
        +int id
        +int capacity
        +int teamCount
        +SkillLevel skillLevel
        +MatchStatus status
        +TimeSlot slot
    }
    class Tournament {
        +int id
        +string name
    }
    class BracketMatch {
        +int id
        +int roundNumber
        +int position
        +int scoreA
        +int scoreB
    }
    class ActivityRecord {
        +int matchId
        +string sport
    }
    class Role {
        <<enumeration>>
        STUDENT
        CLUB_REPRESENTATIVE
        FACILITY_STAFF
    }
    class SkillLevel {
        <<enumeration>>
        BEGINNER
        INTERMEDIATE
        ADVANCED
    }
    class MatchStatus {
        <<enumeration>>
        OPEN
        FULL
        COMPLETED
        CANCELLED
    }

    User "1" --> "0..1" Profile : has
    User --> Role
    User "1" --> "*" VerificationCode : receives
    Profile --> SkillLevel : skill per sport
    Profile "*" --> "*" Sport : rated in
    Profile "1" o-- "*" TimeSlot : availability
    User "1" --> "*" Match : organizes
    Match "1" *-- "*" Participation : participants
    Participation "*" --> "1" User
    Match "*" --> "1" Sport
    Match "*" --> "1" Facility : played at
    Match --> MatchStatus
    Facility "*" --> "*" Sport : supports
    Facility "1" o-- "*" FacilityBlock : blocked periods
    User "1" --> "*" Tournament : organizes
    Tournament "1" *-- "*" Team : registers
    Tournament "*" --> "1" Sport
    Tournament "1" *-- "*" BracketMatch : bracket
    BracketMatch "*" --> "0..2" Team : plays
    BracketMatch "*" --> "0..1" Team : winner
    BracketMatch "*" --> "0..1" Facility : optional slot
    User "1" --> "*" ActivityRecord : history
